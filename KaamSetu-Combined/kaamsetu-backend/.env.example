# Copy values into your environment (this project reads process.env only; no dotenv dependency).
# For production use ../deploy/.env.production.example instead.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/kaamsetu.db
SESSION_TTL_HOURS=168
# Comma-separated browser origins allowed to call the API from a DIFFERENT origin. Leave empty for same-origin.
# Development default (when unset): http://localhost:8080,http://127.0.0.1:8080. Production default: none.
ALLOWED_ORIGINS=
# Serve the static frontend from the same origin (path to the frontend folder)
STATIC_DIR=
REQUIRE_FULL_TERMS=true
# true only behind a trusted reverse proxy that SETS X-Forwarded-For (used for rate limiting and logs)
TRUST_PROXY=false
NODE_ENV=
# --- operations ---
LOG_LEVEL=info                # debug|info|warn|error|silent  (JSON lines on stdout/stderr)
ALERT_WEBHOOK_URL=            # https webhook for error alerts; empty = alerts only logged
ALERT_MIN_INTERVAL_SEC=300    # same alert is sent at most once per interval
HSTS=                         # defaults to true when NODE_ENV=production
MAINTENANCE_INTERVAL_MIN=60   # purge dead sessions / old replay keys (0 = startup only)
SESSION_RETENTION_DAYS=7
IDEMPOTENCY_RETENTION_HOURS=48
BACKUP_DIR=                   # default: <db folder>/backups
BACKUP_INTERVAL_HOURS=0       # 0 = no in-process schedule (then run `npm run backup` from cron/systemd timer)
BACKUP_KEEP=14
