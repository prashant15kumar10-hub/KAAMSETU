# Copy to deploy/.env (Docker) or /etc/kaamsetu/kaamsetu.env (systemd). NEVER commit the real file. Contains no real secrets here.
DOMAIN=kaamsetu.example.com
# Where error alerts go (Slack/Discord-style incoming webhook, or an automation URL). Must be https. Leave empty to disable.
ALERT_WEBHOOK_URL=
# ALLOWED_ORIGINS stays EMPTY when the site and API share one domain (the default deployment).
ALLOWED_ORIGINS=
LOG_LEVEL=info
SESSION_TTL_HOURS=168
REQUIRE_FULL_TERMS=true
# systemd only (Docker sets these itself):
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
# TRUST_PROXY=true
# DB_PATH=/var/lib/kaamsetu/kaamsetu.db
# STATIC_DIR=/opt/kaamsetu/kaamsetu-frontend
# BACKUP_INTERVAL_HOURS=6

# REQUIRED for production startup: point to your own HTTPS delivery adapter.
# Adapter receives JSON {to, channel, code, purpose, expires_in_seconds} with Bearer auth,
# then sends the code by email (channel=email) or SMS (channel=phone). It should return 2xx only on acceptance.
REQUIRE_IDENTIFIER_VERIFICATION=true
REQUIRE_ADMIN_MFA=true
VERIFICATION_DELIVERY_URL=https://your-private-delivery-adapter.example/send
VERIFICATION_DELIVERY_TOKEN=replace-with-long-random-provider-token
VERIFICATION_CODE_SECRET=replace-with-at-least-32-random-characters-from-a-secret-manager
MFA_ENCRYPTION_KEY=replace-with-a-different-32-plus-character-random-secret
